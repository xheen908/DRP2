# DRP/drp2/api-gateway/.env.example
#
# Diese Datei zeigt, welche Umgebungsvariablen der API Gateway benötigt.
# Die tatsächlichen Werte kommen aus der globalen DRP/drp2/.env Datei.

PORT=3000

# Interne URLs der Microservices
AUTH_SERVICE_URL=http://auth-service:3001
JOB_SERVICE_URL=http://job-service:3002
SHIFT_SERVICE_URL=http://shift-service:3003
LOCATION_SERVICE_URL=http://location-service:3004
CLIENT_SERVICE_URL=http://client-service:3006
FRONTEND_EJS_SERVICE_URL=http://frontend-ejs-service:3007
HR_SERVICE_URL=http://hr-service:3008

# JWT Secret (MUSS mit dem Auth Service übereinstimmen!)
JWT_SECRET=Ihr_super_geheimer_JWT_Schlüssel_hier

# Google Maps API Key (nur wenn EJS-Templates ihn direkt verwenden)
GOOGLE_MAPS_API_KEY=google_maps_key