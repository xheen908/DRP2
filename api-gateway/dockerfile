# Dockerfile für den API Gateway Microservice

# Basis-Image: Node.js 22-alpine für Alpine Linux
FROM node:22-alpine

# Setze das Arbeitsverzeichnis im Container
WORKDIR /app

# Kopiere package.json und package-lock.json
COPY package*.json ./

# Installiere Abhängigkeiten
RUN npm install --omit=dev

# Kopiere den Rest des Anwendungscodes (einschließlich views/ und public/)
COPY . .

# Öffne den Port, auf dem das Gateway lauscht (muss mit port 3000 in server.js übereinstimmen)
EXPOSE 3000

# Startet die Anwendung
CMD [ "npm", "start" ]