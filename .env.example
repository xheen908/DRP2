# DRP/.env
#
# Dies ist die zentrale Umgebungsvariablen-Datei für Docker Compose.
# Stellen Sie sicher, dass diese Datei im Root-Verzeichnis Ihres DRP-Projekts liegt.
#
# Die Werte hier werden von der docker-compose.yml gelesen und in die Container injiziert.

# --- Datenbank-Konfiguration (für den zentralen MySQL-Server) ---
DB_USER=drpuser
DB_PASS=drppassword
# Der DB_NAME für den primären MySQL_DATABASE in docker-compose.yml ist 'auth_db',
# und die weiteren DBs werden durch MYSQL_MULTIPLE_DATABASES erstellt.
# Jeder Service nutzt dann seinen spezifischen DB_NAME in seiner eigenen .env

# --- JWT Secret (für Auth Service und API Gateway) ---
# DIESER SCHLÜSSEL MUSS SEHR KOMPLEX UND GEHEIM SEIN!
# UND EXAKT GLEICH IN AUTH SERVICE UND API GATEWAY VERWENDET WERDEN.
JWT_SECRET=Ihr_super_geheimer_JWT_Schlüssel_hier

# --- Google Maps API Key (für Location Service und/oder Frontend) ---
# Wenn Sie Google Maps nutzen, fügen Sie hier Ihren API-Schlüssel ein.
GOOGLE_MAPS_API_KEY=dein_google_map_api_key

# --- Cloudflare Tunnel Token (für Cloudflared Tunnel Service) ---
# Dies ist das Token, das Sie von Cloudflare für Ihren Tunnel erhalten.
TUNNEL_TOKEN=dein_cloudflare_zero_trust_tunnel_token
