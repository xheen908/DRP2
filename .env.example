# ==========================================
# ENV Variables for DRP2 Microservices
# ==========================================

# ------------------------------------------
# Environment & Server Ports
# ------------------------------------------
NODE_ENV=development

# Optional: You can specify ports explicitly, though they fallback to these default values:
# API_GATEWAY_PORT=3000
# AUTH_SERVICE_PORT=3001
# JOB_SERVICE_PORT=3002
# SHIFT_SERVICE_PORT=3003
# HR_SERVICE_PORT=3008 (Note: you had overlapping ports for shift/hr in the code, typical HR port might be 3008)
# LOCATION_SERVICE_PORT=3004
# CLIENT_SERVICE_PORT=3006
# FRONTEND_EJS_SERVICE_PORT=3007
# PAYROLL_SERVICE_PORT=3009
# FILESTORAGE_SERVICE_PORT=3010

# ------------------------------------------
# Database Configuration (MySQL / PostgreSQL)
# ------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=secret
DB_NAME=drp_db

# ------------------------------------------
# Service Networking URLs
# Used for internal communication between microservices
# ------------------------------------------
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://auth-service:3001
JOB_SERVICE_URL=http://job-service:3002
SHIFT_SERVICE_URL=http://shift-service:3006 # Depending on your docker-compose Setup
HR_SERVICE_URL=http://hr-service:3008
LOCATION_SERVICE_URL=http://location-service:3004
CLIENT_SERVICE_URL=http://client-service:3006
FRONTEND_EJS_SERVICE_URL=http://frontend-ejs-service:3007
PAYROLL_SERVICE_URL=http://payroll-service:3009
FILE_STORAGE_SERVICE_URL=http://filestorage-service:3010
TAX_SERVICE_URL=http://tax-engine:8080

# ------------------------------------------
# Security
# ------------------------------------------
# Needed in API Gateway, Auth Service, Frontend EJS Service
JWT_SECRET=your_super_secret_jwt_key

# ------------------------------------------
# External APIs
# ------------------------------------------
# Needed in Frontend EJS Service, API Gateway for Maps integration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ------------------------------------------
# File Storage / Rclone / S3 Configuration
# Needed in Filestorage Service
# ------------------------------------------
RCLONE_REMOTE_NAME=my_remote
RCLONE_BUCKET_NAME=my_bucket
S3_ACCESS_KEY_ID=your_s3_key
S3_SECRET_ACCESS_KEY=your_s3_secret
S3_ENDPOINT=your_s3_endpoint_url
