# DRP/drp2/job-service/.env.example
#
# Umgebungsvariablen für den Job Service.
# Die tatsächlichen Werte kommen aus der globalen DRP/drp2/.env Datei.

PORT=3002

# MySQL Datenbank-Konfiguration
DB_HOST=mysql-db
DB_USER=drpuser
DB_PASSWORD=drppassword
DB_NAME=job_db

# URLs der Microservices, mit denen der Job Service kommuniziert
AUTH_SERVICE_URL=http://auth-service:3001
CLIENT_SERVICE_URL=http://client-service:3006
LOCATION_SERVICE_URL=http://location-service:3004