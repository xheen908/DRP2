# DRP/drp2/frontend-ejs-service/.env.example
#
# Diese Datei zeigt, welche Umgebungsvariablen der Frontend EJS Service benötigt.
# Die tatsächlichen Werte kommen aus der globalen DRP/drp2/.env Datei.

PORT=3007

# URL des API Gateways, um Backend-Daten abzurufen (interne Docker-URL)
API_GATEWAY_URL=http://api-gateway:3000

# JWT Secret (Nur wenn der Frontend Service JWTs direkt lesen/prüfen muss, was hier vom Gateway übernommen wird)
# Wenn der Frontend Service selbst redirects basierend auf JWTs durchführen soll,
# muss das Secret hier bekannt sein, aber die Hauptvalidierung erfolgt im Gateway.
JWT_SECRET=Ihr_super_geheimer_JWT_Schlüssel_hier

# Google Maps API Key (Wird über Header vom Gateway kommen, aber hier als Fallback/Debug-Option)
GOOGLE_MAPS_API_KEY=dein_google_maps_key
