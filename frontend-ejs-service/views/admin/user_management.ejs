        function getAuthHeader() {
            const jwtCookie = document.cookie.split('; ').find(row => row.startsWith('jwt='));
            if (jwtCookie) {
                const token = jwtCookie.split('=')[1];
                return { 'Authorization': `Bearer ${token}` };
            }
            return {};
        }

        async function openVpnModal(userId, fullName) {
            currentVpnUserName = fullName;
            vpnPreview.textContent = "Lade Konfiguration...";
            vpnModal.style.display = 'flex';

            try {
                const response = await fetch(`/api/vpn/clients/user/${userId}/config`, {
                    headers: getAuthHeader()
                });
                if (!response.ok) throw new Error('Kein VPN Profil gefunden.');
                
                currentVpnConfig = await response.text();
                vpnPreview.textContent = currentVpnConfig.substring(0, 100) + "...";
                
                QRCode.toCanvas(vpnQrCanvas, currentVpnConfig, { width: 256 }, function (error) {
                    if (error) console.error(error);
                });
            } catch (err) {
                vpnPreview.textContent = err.message;
            }
        }

        function closeVpnModal() {
            vpnModal.style.display = 'none';
        }

        function downloadVpnConfig() {
            const blob = new Blob([currentVpnConfig], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `vpn_${currentVpnUserName.replace(/\s/g, '_')}.conf`;
            a.click();
        }

