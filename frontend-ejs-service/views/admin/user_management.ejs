        // Funktion zum Sammeln aller Formular-Daten
        function collectFormData() {
            const formData = new FormData(userForm);
            const data = {};
            for (let [key, value] of formData.entries()) {
                // Handle nested arrays like addresses[0][street]
                const match = key.match(/^(\w+)\[(\d+)\]\[(\w+)\]$/);
                if (match) {
                    const [, parent, index, childKey] = match;
                    if (!data[parent]) {
                        data[parent] = [];
                    }
                    if (!data[parent][index]) {
                        data[parent][index] = {};
                    }
                    if (value === 'on' && formData.get(key) !== null) { // Handle checkboxes, only if checked
                         data[parent][index][childKey] = true;
                    } else if (formData.get(key) === null && key.endsWith('[isPrimary]')) { // Handle unchecked checkboxes
                         data[parent][index][childKey] = false;
                    } else {
                        data[parent][index][childKey] = value;
                    }
                } else if (key.match(/^(\w+)\[(\w+)\]$/)) { // Handle nested objects like bankDetails[bankName]
                    const [, parent, childKey] = key.match(/^(\w+)\[(\w+)\]$/);
                    if (!data[parent]) {
                        data[parent] = {};
                    }
                    if (value === 'on' && formData.get(key) !== null) { // Handle checkboxes
                         data[parent][childKey] = true;
                    } else if (formData.get(key) === null && key.endsWith('[churchTaxApplicable]')) {
                         data[parent][childKey] = false;
                    } else {
                        data[parent][childKey] = value;
                    }
                } else if (key === 'salary' || key === 'annualLeaveEntitlement' || key === 'taxClass' || key === 'childAllowances' || key === 'additionalTaxAllowances') {
                    data[key] = value ? parseFloat(value) : null;
                } else if (key === 'churchTaxApplicable') {
                    data[key] = value === 'on'; // Checkboxen als Boolean behandeln, falls nicht als nested Object gesendet
                } else if (key !== 'confirmPassword') { // confirmPassword nicht senden
                    data[key] = value;
                }
            }

            // Manuelle Behandlung für Checkboxen, die nicht als Teil eines assoziierten Objekts gesendet wurden,
            // wenn sie unchecked sind (FormData sendet nur checked values).
            // Dies ist jetzt durch die Logik im match-Block besser abgedeckt, aber zur Sicherheit:
            if (data.taxSocialSecurity && formData.get('taxSocialSecurity[churchTaxApplicable]') === null) {
                data.taxSocialSecurity.churchTaxApplicable = false;
            }


            // Filtern von leeren assoziierten Objekten/Arrays, damit sie nicht unnötig gesendet werden
            if (data.bankDetails && Object.values(data.bankDetails).every(x => !x || x === '')) {
                delete data.bankDetails;
            } else if (data.bankDetails && data.bankDetails.id === '') { // Wenn nur ID leer ist
                delete data.bankDetails.id;
            }

            if (data.taxSocialSecurity && Object.values(data.taxSocialSecurity).every(x => !x || x === '')) {
                delete data.taxSocialSecurity;
            } else if (data.taxSocialSecurity && data.taxSocialSecurity.id === '') { // Wenn nur ID leer ist
                delete data.taxSocialSecurity.id;
            }

            if (data.addresses) {
                data.addresses = data.addresses.filter(addr => Object.values(addr).some(x => x !== null && x !== '' && x !== false));
                data.addresses.forEach(addr => {
                    if (addr.id === '') delete addr.id;
                });
            } else {
                data.addresses = [];
            }
            
            if (data.emergencyContacts) {
                data.emergencyContacts = data.emergencyContacts.filter(contact => Object.values(contact).some(x => x !== null && x !== '' && x !== false));
                data.emergencyContacts.forEach(contact => {
                    if (contact.id === '') delete contact.id;
                });
            } else {
                data.emergencyContacts = [];
            }

            return data;
        }


        userForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            
            const formData = collectFormData(); // Alle Daten aus dem Formular sammeln

            // Auth Service Daten
            const pin = formData.pin;
            const password = formData.password;
            const confirmPassword = formData.confirmPassword; // Wird nicht an API gesendet
            const roleId = parseInt(formData.roleId);
            
            // HR Service Daten
            const firstName = formData.firstName;
            const lastName = formData.lastName;
            const email = formData.email;
            const gender = formData.gender;
            const maritalStatus = formData.maritalStatus;
            const nationality = formData.nationality;
            const dateOfBirth = formData.dateOfBirth;
            const privatePhone = formData.privatePhone;
            const dateOfHire = formData.dateOfHire;
            const department = formData.department;
            const workLocation = formData.workLocation;
            const workScheduleType = formData.workScheduleType;
            const annualLeaveEntitlement = formData.annualLeaveEntitlement;
            const salary = formData.salary;
            const employeeStatus = formData.status;

            // Assoziierte HR Daten
            const addresses = formData.addresses;
            const bankDetails = formData.bankDetails;
            const taxSocialSecurity = formData.taxSocialSecurity;
            const emergencyContacts = formData.emergencyContacts;
            
            // NEU: isActive wird basierend auf employeeStatus abgeleitet
            const isActiveDerived = (employeeStatus !== 'inactive' && employeeStatus !== 'terminated');


            // Allgemeine Validierungen für neue Benutzer
            if (currentEditingUserId === null) {
                if (!firstName || !lastName || !email || !dateOfHire) {
                    alert('Bitte füllen Sie alle erforderlichen HR-Felder aus.');
                    return;
                }
                if (!password || password.length < 6) {
                    alert('Passwort muss mindestens 6 Zeichen lang sein.');
                    return;
                }
                if (password !== confirmPassword) {
                    alert('Passwörter stimmen nicht überein.');
                    return;
                }
                // PIN Validierung nur beim Erstellen (generierte PIN)
                if (pin && !/^[0-9]{6,10}$/.test(pin)) {
                    alert('PIN muss 6 bis 10 Ziffern enthalten.');
                    return;
                }
            } else { // Validierungen für bestehende Benutzer
                 // Nur wenn Passwortfelder ausgefüllt, prüfen
                if (password && password.length > 0) {
                    if (password.length < 6) {
                        alert('Passwort muss mindestens 6 Zeichen lang sein.');
                        return;
                    }
                    if (password !== confirmPassword) {
                        alert('Passwörter stimmen nicht überein.');
                        return;
                    }
                }
                // Validierung für PIN, wenn sie geändert wurde
                if (pin && pin !== allUsers.find(u => u.id === currentEditingUserId)?.pin) {
                    if (!/^[0-9]{6,10}$/.test(pin)) {
                        alert('PIN muss 6 bis 10 Ziffern enthalten.');
                        return;
                    }
                }
            }

            try {
                let response;
                const requestBody = { 
                    role_id: roleId, 
                    isActive: isActiveDerived, 
                    pin: pin,
                    firstName: firstName, 
                    lastName: lastName,
                    email: email,
                    gender: gender,
                    maritalStatus: maritalStatus,
                    nationality: nationality,
                    dateOfBirth: dateOfBirth,
                    privatePhone: privatePhone,
                    dateOfHire: dateOfHire,
                    department: department,
                    workLocation: workLocation,
                    workScheduleType: workScheduleType,
                    annualLeaveEntitlement: annualLeaveEntitlement,
                    salary: salary,
                    status: employeeStatus,
                    addresses: addresses,
                    bankDetails: bankDetails,
                    taxSocialSecurity: taxSocialSecurity,
                    emergencyContacts: emergencyContacts
                };

                // Entferne leere oder irrelevante Felder, bevor sie gesendet werden
                Object.keys(requestBody).forEach(key => {
                    if (requestBody[key] === null || requestBody[key] === '' || 
                        (Array.isArray(requestBody[key]) && requestBody[key].length === 0) ||
                        (typeof requestBody[key] === 'object' && Object.keys(requestBody[key]).length === 0 && key !== 'bankDetails' && key !== 'taxSocialSecurity')) {
                        delete requestBody[key];
                    }
                });
                // Spezielle Behandlung für bankDetails und taxSocialSecurity wenn sie leer sind
                if (requestBody.bankDetails && Object.values(requestBody.bankDetails).every(x => x === null || x === '' || x === undefined || (typeof x === 'boolean' && x === false))) {
                     delete requestBody.bankDetails;
                }
                if (requestBody.taxSocialSecurity && Object.values(requestBody.taxSocialSecurity).every(x => x === null || x === '' || x === undefined || (typeof x === 'boolean' && x === false))) {
                     delete requestBody.taxSocialSecurity;
                }


                if (currentEditingUserId) {
                    // Bearbeiten eines bestehenden Benutzers
                    response = await fetch(`/api/users/${currentEditingUserId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                        body: JSON.stringify(requestBody)
                    });
                    if (!response.ok) {
                         const errorData = await response.json();
                         throw new Error(errorData.message || 'Fehler beim Aktualisieren der Benutzerdetails.');
                    }
                    // Dann, wenn ein neues Passwort eingegeben wurde, das Passwort aktualisieren
                    if (password && password.length >= 6) {
                        response = await fetch(`/api/users/${currentEditingUserId}/password`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                            body: JSON.stringify({ newPassword: password })
                        });
                        if (!response.ok) {
                            const errorData = await response.json();
                            throw new Error(errorData.message || 'Fehler beim Aktualisieren des Passworts.');
                        }
                    }

                } else {
                    // Neuen Benutzer erstellen (PIN wird vom Backend generiert, daher nicht im body)
                    delete requestBody.pin; // PIN nicht anlegen, da sie generiert wird
                    response = await fetch('/api/users', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                        body: JSON.stringify(requestBody)
                    });
                    if (response.ok) {
                        const responseData = await response.json();
                        alert(`Benutzer erfolgreich erstellt! Generierte PIN: ${responseData.pin || 'Nicht verfügbar'}`);
                    }
                }

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || 'Fehler bei der Operation.');
                }

                userFormModal.style.display = 'none';
                await fetchUsers();
            } catch (error) {
                alert('Fehler: ' + error.message);
                console.error('Fehler bei Benutzeroperation:', error);
            }
        });

        async function deleteUser(userId) {
            if (!confirm('Sind Sie sicher, dass Sie diesen Benutzer löschen möchten?')) {
                return;
            }

            try {
                const response = await fetch(`/api/users/${userId}`, {
                    method: 'DELETE',
                    headers: { ...getAuthHeader() }
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || 'Fehler beim Löschen des Benutzers.');
                }

                alert('Benutzer erfolgreich gelöscht!');
                await fetchUsers();
            } catch (error) {
                alert('Fehler: ' + error.message);
                console.error('Fehler beim Löschen des Benutzers:', error);
            }
        }

        function openBarcodeModal(pin, userFullName) {
            barcodeModalTitle.textContent = `Barcode für ${userFullName}`;
            barcodeValueSpan.textContent = pin;

            barcodeSvg.innerHTML = '';
            JsBarcode("#barcode-svg", pin, {
                format: "CODE128",
                displayValue: true,
                fontSize: 24,
                width: 2,
                height: 100,
                margin: 10
            });
            barcodeModal.style.display = 'flex';
        }

        function closeBarcodeModal() {
            barcodeModal.style.display = 'none';
            barcodeSvg.innerHTML = '';
            barcodeValueSpan.textContent = '';
        }

        window.openVpnModal = openVpnModal;
        window.closeVpnModal = closeVpnModal;
        window.downloadVpnConfig = downloadVpnConfig;

        document.addEventListener('DOMContentLoaded', async () => {
            if (loggedInUser.roles && loggedInUser.roles.includes('Manager')) {
                await fetchRoles();
                await fetchUsers();
            } else {
                userListContainer.innerHTML = '<p class="text-center text-red-500 py-4">Sie haben keine Berechtigung, die Benutzerverwaltung zu sehen.</p>';
                if (addUserButton) addUserButton.style.display = 'none';
            }

            if (addUserButton) {
                addUserButton.addEventListener('click', openAddUserModal);
            }

            window.onclick = function(event) {
                if (event.target === barcodeModal) {
                    closeBarcodeModal();
                }
                if (event.target === userFormModal) {
                    cancelUserForm();
                }
                if (event.target === vpnModal) {
                    closeVpnModal();
                }
            }
        });
        window.openBarcodeModal = openBarcodeModal;
        window.openEditUserModal = openEditUserModal;
        window.deleteUser = deleteUser;
        window.addAddressField = addAddressField; // Exponieren für onclick
        window.removeAddressField = removeAddressField; // Exponieren für onclick
        window.addBankDetailsField = addBankDetailsField; // Exponieren für onclick
        window.removeBankDetailsField = removeBankDetailsField; // Exponieren für onclick
        window.addTaxSocialSecurityField = addTaxSocialSecurityField; // Exponieren für onclick
        window.removeTaxSocialSecurityField = removeTaxSocialSecurityField; // Exponieren für onclick
        window.addEmergencyContactField = addEmergencyContactField; // Exponieren für onclick
        window.removeEmergencyContactField = removeEmergencyContactField; // Exponieren für onclick

    </script>
</body>
</html>
