        async function logout() {
            try {
                const response = await fetch('/api/auth/logout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    window.location.href = '/';
                } else {
                    const errorData = await response.json();
                    alert('Fehler beim Abmelden: ' + (errorData.message || 'Unbekannter Fehler'));
                    console.error('Logout-Fehler-Antwort:', errorData);
                }
            } catch (error) {
                console.error('Fehler beim Abmelden:', error);
                alert('Netzwerkfehler beim Abmelden. Bitte versuchen Sie es erneut.');
            }
        }

        async function fetchUsers() {
            try {
                const response = await fetch('/api/users', {
                    headers: { 
                        'Content-Type': 'application/json',
                        ...getAuthHeader() 
                    }
                });
                if (!response.ok) {
                    if (response.status === 401 || response.status === 403) {
                        window.location.href = '/';
                        return;
                    }
                    throw new Error('Fehler beim Laden der Benutzer: ' + response.statusText);
                }
                allUsers = await response.json();
                renderUserList();
            } catch (error) {
                console.error('Fehler beim Abrufen der Benutzer:', error);
                userListContainer.innerHTML = `<p class="text-center text-red-500 py-4">Fehler beim Laden der Benutzer: ${error.message}</p>`;
            }
        }

        async function fetchRoles() {
            try {
                const response = await fetch('/api/users/roles', {
                    headers: { 
                        'Content-Type': 'application/json',
                        ...getAuthHeader() 
                    }
                });
                if (!response.ok) {
                    if (response.status === 401 || response.status === 403) {
                        window.location.href = '/';
                        return;
                    }
                    throw new Error('Fehler beim Laden der Rollen: ' + response.statusText);
                }
                allRoles = await response.json();
                console.log('[Frontend Debug] Geladene Rollen:', allRoles); 
                renderRoleOptions();
            } catch (error) {
                console.error('Fehler beim Abrufen der Rollen:', error);
            }
        }

