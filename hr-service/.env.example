# DRP2 HR Service Umgebungsvariablen

# Port, auf dem der HR Service läuft
PORT=3008

# Datenbankkonfiguration (MySQL)
DB_DIALECT=mysql
DB_HOST=mysql-db 
DB_PORT=3306
DB_USER=drpuser 
DB_PASSWORD=drppassword 
DB_NAME=hr_db

# URL des Authentifizierungsdienstes (für interne Kommunikation)
AUTH_SERVICE_URL=http://auth-service:3001