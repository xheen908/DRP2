# DRP/drp2/auth-service/.env.example
#
# Umgebungsvariablen für den Auth Service.
# Die tatsächlichen Werte kommen aus der globalen DRP/drp2/.env Datei.

PORT=3001

# MySQL Datenbank-Konfiguration
DB_HOST=mysql-db
DB_USER=drpuser
DB_PASSWORD=drppassword
DB_NAME=auth_db

# JWT Secret (MUSS mit dem API Gateway übereinstimmen!)
JWT_SECRET=Ihr_super_geheimer_JWT_Schlüssel_hier

HR_SERVICE_URL=http://hr-service:3008

# Redis Konfiguration
REDIS_HOST=redis-cache
REDIS_PORT=6379