# DRP/drp2/client-service/.env.example
#
# Umgebungsvariablen für den Client Service.
# Die tatsächlichen Werte kommen aus der globalen DRP/drp2/.env Datei.

PORT=3006

# MySQL Datenbank-Konfiguration
DB_HOST=mysql-db
DB_USER=drpuser
DB_PASSWORD=drppassword
DB_NAME=client_db

# Falls der Client Service interne Auth-Prüfungen benötigt (z.B. User-Rollen abrufen)
AUTH_SERVICE_URL=http://auth-service:3001